@define-color main-bg rgb(61, 71, 69);
@define-color main-fg rgba(234,214,218,1);
@define-color wb-act-bg rgba(27,29,22,1);
@define-color wb-act-fg rgba(217,215,195,1);
@define-color wb-hvr-bg rgba(60,64,40,1);
@define-color wb-hvr-fg rgba(155,154,98,1);
